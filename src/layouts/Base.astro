---
import '../styles/global.css';
import MetaTags from '../components/MetaTags.astro';
import ThemeToggle from '../components/ThemeToggle.svelte';
import PagefindSearch from '../components/PagefindSearch.svelte';
import type { OgImage } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  image?: OgImage;
  category?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const { title, description, image, category, jsonLd, noindex, ogType } = Astro.props;
---

<!doctype html>
<html lang="en" data-mode="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <MetaTags
      title={title}
      description={description}
      pathname={Astro.url.pathname}
      image={image}
      category={category}
      jsonLd={jsonLd}
      noindex={noindex}
      ogType={ogType}
    />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,500;6..96,600;6..96,700&family=Figtree:wght@400;500;650;800&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script is:inline>
      // Mode is applied before first paint. A Svelte island cannot do this — it
      // hydrates after paint, which guarantees a flash of the wrong theme on
      // every navigation. This is the case where 12 inline lines beat an island.
      (() => {
        const KEY = 'ltk:mode';
        let m = null;
        try {
          m = localStorage.getItem(KEY);
        } catch {}
        if (m !== 'light' && m !== 'dark' && m !== 'vibrant') {
          m = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.mode = m;
      })();
    </script>
    <style>
      .site-head__search { flex: 1 1 22rem; max-width: 30rem; margin-inline: 1rem; }
      /* The previous narrow treatment pushed search to `order: 3` and a full-width
         second row. With the nav now collapsing behind a hamburger there is room
         to keep everything on one line, and the old rule actively fought it —
         `order: 3` re-sorted search BEHIND the theme toggle, so the row read
         hamburger, moon, search. Search now simply takes the reclaimed space. */
      @container head (max-width: 52rem) {
        .site-head__search { margin-inline: 0; max-width: none; }
      }
    </style>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-head">
      <div class="shell site-head__inner">
        <a class="wordmark" href="/">Lossless<b>·</b>Toolkit</a>

        <button
          type="button"
          class="nav-toggle"
          id="nav-toggle"
          aria-expanded="false"
          aria-controls="nav-menu"
          aria-label="Open menu"
        >
          <svg class="nav-toggle__open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
          </svg>
          <svg class="nav-toggle__close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="5" y1="5" x2="19" y2="19" /><line x1="19" y1="5" x2="5" y2="19" />
          </svg>
        </button>

        <div class="site-head__search">
          <PagefindSearch client:idle placeholder="Search…" />
        </div>

        <nav class="site-nav" id="nav-menu" aria-label="Primary">
          <!-- Home carries the wordmark's job inside the panel, since the
               wordmark itself is what collapsed. Hidden at full width, where
               the wordmark is already doing it. -->
          <a class="site-nav__home" href="/">Lossless<b>·</b>Toolkit</a>
          <a href="/toolkit/">Explore</a>
          <a href="/verticals/">Verticals</a>
          <a href="/tags/">Tags</a>
          <a href="/curious-clients/">Clients</a>
        </nav>

        <ThemeToggle client:idle />
      </div>
    </header>

    <main id="main" data-pagefind-body>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="shell">
        <p>
          The Lossless Toolkit — a catalogue of the tools we actually use with clients. Static by
          default; interactive where interactivity earns it.
        </p>
        <p>
          <a href="/llms.txt">llms.txt</a> · <a href="/sitemap-index.xml">sitemap</a> ·
          <a href="/toolkit/">full index</a>
        </p>
      </div>
    </footer>

    <style>
      .skip {
        position: absolute;
        inset-inline-start: -9999px;
        top: 0;
        background: var(--clr-accent);
        color: var(--clr-accent-ink);
        padding: 0.6rem 1rem;
        z-index: 100;
      }
      .skip:focus {
        inset-inline-start: 0;
      }
    </style>
    <script>
      // Nav collapse. The CSS decides WHETHER the panel exists (container query);
      // this only decides whether it is open.
      function wireNav() {
        const toggle = document.getElementById('nav-toggle');
        const menu = document.getElementById('nav-menu');
        if (!toggle || !menu || toggle.dataset.wired) return;
        toggle.dataset.wired = 'true';

        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          if (open) menu.setAttribute('data-open', '');
          else menu.removeAttribute('data-open');
        };

        toggle.addEventListener('click', () =>
          setOpen(toggle.getAttribute('aria-expanded') !== 'true')
        );

        // Collapse on choosing a destination — the panel covers the content, so
        // leaving it open hides whatever the reader just asked to see.
        menu.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) setOpen(false);
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            toggle.focus();
          }
        });

        document.addEventListener('click', (e) => {
          if (toggle.getAttribute('aria-expanded') !== 'true') return;
          const t = e.target as HTMLElement;
          if (!menu.contains(t) && !toggle.contains(t)) setOpen(false);
        });

        // Growing back to the wide layout must clear the open state, or
        // data-open survives and the panel reappears on the next narrowing.
        // Observed on the CONTAINER, not the viewport, to match the CSS.
        // No breakpoint number here on purpose. A copy in JS is a second place
        // to update and a guaranteed drift; instead ask the CSS whether the
        // hamburger is currently rendered at all. When the container grows past
        // the query, the toggle goes display:none and the panel must close, or
        // data-open survives and it reappears on the next narrowing.
        const head = document.querySelector('.site-head__inner');
        if (head) {
          new ResizeObserver(() => {
            if (getComputedStyle(toggle).display === 'none') setOpen(false);
          }).observe(head);
        }
      }

      wireNav();
      document.addEventListener('astro:page-load', wireNav);
    </script>
  </body>
</html>
