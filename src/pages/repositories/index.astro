---
/**
 * Every tool in the catalogue whose source-code home the corpus records.
 *
 * The list is assembled from four different frontmatter spellings — including
 * one misspelt key that seven entries depend on exclusively. See `pickRepo()`
 * in content-api for why that matters.
 */
import Base from '../../layouts/Base.astro';
import { listRepos, tagSlug } from '../../lib/content-api';
import { abs } from '../../lib/seo';

const repos = listRepos().sort((a, b) => b.depth - a.depth);

const projects = repos.filter((t) => t.repoKind === 'repo');
const profiles = repos.filter((t) => t.repoKind === 'profile');

/** `https://github.com/dokku/dokku` -> `dokku/dokku` */
function ownerPath(url: string): string {
  try {
    return new URL(url).pathname.replace(/^\/|\/$/g, '') || new URL(url).host;
  } catch {
    return url;
  }
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Open source repositories',
  url: abs('/repositories/'),
  description: `${repos.length} tools in the Lossless Toolkit with a public source-code home.`,
};
---

<Base
  title="Repositories"
  description={`${repos.length} tools in the catalogue with a public source-code home — ${projects.length} linking a project, ${profiles.length} linking the org that maintains it.`}
  category="repositories"
  jsonLd={jsonLd}
>
  <section class="shell block">
    <header class="block__head">
      <p class="eyebrow">GitHub</p>
      <h1>Repositories</h1>
      <p class="dim">
        {repos.length} of the catalogue's tools record where their source lives — {projects.length} point
        at a project, {profiles.length} at the organisation that maintains it. Every link leaves for
        the host.
      </p>
    </header>

    <ul class="repo-list">
      {repos.map((t) => (
        <li class="repo">
          <div class="repo__main">
            <a class="repo__title" href={`/toolkit/${t.slug}/`}>{t.title}</a>
            {t.summary && <p class="repo__summary">{t.summary}</p>}
            <div class="repo__tags">
              {t.tags.slice(0, 4).map((g) => (
                <a class="chip" href={`/tags/${tagSlug(g)}/`}>{g}</a>
              ))}
            </div>
          </div>

          <a class="repo__link" href={t.repoUrl} rel="noopener noreferrer nofollow" target="_blank">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
            <span class="repo__path">{ownerPath(t.repoUrl!)}</span>
            <span class={`repo__kind repo__kind--${t.repoKind}`}>{t.repoKind === 'repo' ? 'project' : 'org'}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .block__head h1 {
    font-size: var(--step-3);
    margin-block: 0.2rem 0.4rem;
  }

  .repo-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .repo {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 0.9rem 1rem;
    border: 1px solid var(--clr-line);
    border-radius: var(--radius-sm);
    background: var(--clr-ground-raised);
  }
  .repo:hover {
    border-color: var(--clr-line-strong);
  }

  .repo__main {
    flex: 1 1 22rem;
    min-width: 0;
  }

  .repo__title {
    font-weight: 650;
    color: var(--clr-ink);
    text-decoration: none;
  }
  .repo__title:hover {
    color: var(--clr-accent);
  }

  .repo__summary {
    margin: 0.25rem 0 0;
    color: var(--clr-ink-muted);
    font-size: var(--step--1);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .repo__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-block-start: 0.5rem;
  }

  /* The repo link is the point of the row, so it gets the mono treatment and
     sits as its own affordance rather than as a trailing word. */
  .repo__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-shrink: 0;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--clr-line);
    border-radius: var(--radius-sm);
    background: var(--clr-surface);
    color: var(--clr-ink-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-decoration: none;
    max-width: 100%;
  }
  .repo__link:hover {
    color: var(--clr-ink);
    border-color: var(--clr-accent);
  }

  .repo__path {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .repo__kind {
    flex-shrink: 0;
    padding: 0.05rem 0.35rem;
    border-radius: 999px;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .repo__kind--repo {
    background: var(--clr-accent-soft);
    color: var(--clr-accent);
  }
  .repo__kind--profile {
    background: var(--clr-chip);
    color: var(--clr-chip-ink);
  }
</style>
