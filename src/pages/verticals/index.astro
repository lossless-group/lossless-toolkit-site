---
import Base from '../../layouts/Base.astro';
import { listVerticals } from '../../lib/content-api';

const verticals = listVerticals();
const total = verticals.reduce((n, v) => n + v.entries.length, 0);
---

<Base
  title="Vertical toolkits"
  description={`${verticals.length} industry verticals, ${total} catalogued companies and tools — toolkits assembled for a specific sector rather than a general audience.`}
  category="verticals"
>
  <div class="shell page">
    <p class="eyebrow">Verticals</p>
    <h1>Toolkits by industry</h1>
    <p class="lede">
      {verticals.length} verticals, {total} entries. Where the tag index is the corpus's own
      vocabulary, these are deliberate assemblies — what we would actually hand someone working in
      that sector.
    </p>

    <div class="vgrid">
      {
        verticals.map((v) => (
          <a class="vcard" href={`/verticals/${v.slug}/`}>
            <h2>{v.title}</h2>
            <p class="count">{v.entries.length} entries</p>
            <p class="names">
              {v.entries
                .slice(0, 6)
                .map((e) => e.title)
                .join(' · ')}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .page {
    padding-block: 2.5rem 1rem;
  }
  .page .lede {
    margin-block-end: 2.5rem;
  }
  .vgrid {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
  .vcard {
    display: block;
    padding: 1.2rem 1.1rem;
    border: 1px solid var(--clr-line);
    border-left: 3px solid var(--clr-accent);
    border-radius: var(--radius);
    background: var(--clr-ground-raised);
    color: inherit;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .vcard:hover {
    transform: translateY(-3px);
    box-shadow: var(--glow);
  }
  .vcard h2 {
    font-size: var(--step-1);
    margin: 0 0 0.2rem;
    text-transform: capitalize;
  }
  .count {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--clr-accent);
  }
  .names {
    margin: 0;
    font-size: var(--step--1);
    color: var(--clr-ink-faint);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
