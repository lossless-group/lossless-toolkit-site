---
/**
 * ClientListHorizontalScroller.astro
 *
 * Replicated from lossless-group/site
 * `src/components/basics/messages/ClientListHorizontalScroller--stealth.astro`
 * — the horizontally-scrolling, snap-to-centre row of stealth client cards that
 * sits on the lossless.group index page.
 *
 * Adapted: the source wires its two nav buttons through `window.scroll…Left/Right`
 * globals invoked by inline `onclick` strings. This copy resolves the buttons by
 * selector inside a scoped script instead, so the component can appear more than
 * once on a page without the two instances fighting over the same two globals.
 * `GlassmorphicNavButton` still accepts `onClick`, so the source's calling
 * convention remains available.
 *
 * PROPS:
 * - clients (array, required): stealth client records. `stealth-passcode` is
 *   excluded by construction — see `src/data/clients.json`.
 * - title (string, optional): section heading
 */
import ClientCard from './ClientCard.astro';
import GlassmorphicNavButton from './GlassmorphicNavButton.astro';

interface Client {
  id: string;
  'stealth-name': string;
  'stealth-logo'?: string;
  'stealth-description': string;
  industry: string;
  engagement: string;
  'logo-shape'?: 'icon' | 'wordmark';
}

interface Props {
  clients: Client[];
  title?: string;
}

const { clients, title = 'Current Work' } = Astro.props;
---

<section class="stealth-client-list-section">
  <div class="section-header">
    <GlassmorphicNavButton direction="left" label="Previous clients" class="nav-left" />
    <h2 class="section-title">{title}</h2>
    <GlassmorphicNavButton direction="right" label="Next clients" class="nav-right" />
  </div>

  <div class="clients-container">
    <div class="clients-scroll">
      {clients.map((client) => (
        <ClientCard
          name={client['stealth-name']}
          logo={client['stealth-logo']}
          description={client['stealth-description']}
          industry={client.industry}
          engagement={client.engagement}
          logoShape={client['logo-shape'] ?? 'icon'}
          clientId={client.id}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .stealth-client-list-section {
    margin-bottom: 5rem;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2rem;
    margin-top: 2rem;
    position: relative;
    gap: 2rem;
    flex-direction: row;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--clr-ink);
    margin: 0;
    text-align: center;
  }

  .nav-left {
    position: absolute;
    left: 0;
  }

  .nav-right {
    position: absolute;
    right: 0;
  }

  .clients-container {
    position: relative;
    margin: 2rem -1rem;
    padding: 0 1rem;
    max-width: 100vw;
    overflow: hidden;
  }

  /* The generous inline padding is what lets the first and last card reach the
     centre of the viewport when snapped. */
  .clients-scroll {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    padding: 1rem calc(50% - 160px) 2rem calc(50% - 160px);
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    max-width: 100vw;
  }

  .clients-scroll > :global(*) {
    scroll-snap-align: center;
    flex-shrink: 0;
    height: 300px;
    overflow: visible;
  }

  .clients-scroll::-webkit-scrollbar {
    height: 8px;
  }
  .clients-scroll::-webkit-scrollbar-track {
    background: color-mix(in oklab, var(--clr-ink) 5%, transparent);
    border-radius: 4px;
  }
  .clients-scroll::-webkit-scrollbar-thumb {
    background: color-mix(in oklab, var(--clr-ink) 20%, transparent);
    border-radius: 4px;
  }
  .clients-scroll::-webkit-scrollbar-thumb:hover {
    background: color-mix(in oklab, var(--clr-ink) 30%, transparent);
  }

  @supports (scrollbar-width: thin) {
    .clients-scroll {
      scrollbar-width: thin;
      scrollbar-color: color-mix(in oklab, var(--clr-ink) 20%, transparent)
        color-mix(in oklab, var(--clr-ink) 5%, transparent);
    }
  }

  @media (max-width: 768px) {
    .section-header {
      gap: 1rem;
      margin-bottom: 1.5rem;
      flex-direction: row;
    }
    .section-title {
      font-size: 1.5rem;
    }
    .nav-left,
    .nav-right {
      position: relative;
      left: auto;
      right: auto;
    }
    .clients-container {
      margin: 1rem 0;
      max-width: 100vw;
      overflow: hidden;
      padding: 0;
    }
    .clients-scroll {
      gap: 0.75rem;
      padding: 0.5rem 1rem 1.5rem 1rem;
      max-width: 100vw;
      -webkit-overflow-scrolling: touch;
      scroll-behavior: smooth;
    }
    .clients-scroll > :global(*) {
      min-width: 300px;
      max-width: 300px;
      height: 300px;
      flex-shrink: 0;
      overflow: visible;
    }
  }

  @media (max-width: 480px) {
    .section-header {
      flex-direction: row;
      gap: 0.75rem;
      align-items: center;
    }
    .section-title {
      font-size: 1.25rem;
    }
    .clients-scroll {
      gap: 0.5rem;
      padding: 0.5rem 0.75rem 1rem 0.75rem;
    }
    .clients-scroll > :global(*) {
      min-width: 280px;
      max-width: 280px;
      height: 300px;
      overflow: visible;
    }
  }
</style>

<script>
  // Scoped to each instance rather than hung off `window`, so two scrollers on
  // one page do not overwrite each other's handlers.
  document.querySelectorAll<HTMLElement>('.stealth-client-list-section').forEach((section) => {
    const scroller = section.querySelector<HTMLElement>('.clients-scroll');
    if (!scroller) return;

    // Open on the middle card. Uses scrollLeft rather than scrollIntoView so the
    // page itself does not jump on load.
    const cards = scroller.children;
    const middle = cards[Math.floor(cards.length / 2)] as HTMLElement | undefined;
    if (middle) {
      scroller.scrollLeft = middle.offsetLeft - scroller.clientWidth / 2 + middle.offsetWidth / 2;
    }

    const step = () => {
      const first = scroller.children[0] as HTMLElement | undefined;
      return first ? first.offsetWidth + 24 : 344;
    };

    section
      .querySelector('.nav-left')
      ?.addEventListener('click', () => scroller.scrollBy({ left: -step(), behavior: 'smooth' }));
    section
      .querySelector('.nav-right')
      ?.addEventListener('click', () => scroller.scrollBy({ left: step(), behavior: 'smooth' }));
  });
</script>
