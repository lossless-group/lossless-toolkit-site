---
/**
 * TextCTA.astro
 *
 * Replicated from lossless-group/site `src/components/basics/cta/TextCTA.astro`.
 * A subtle text call-to-action with an arrow that slides on hover.
 *
 * Adapted: the source reads `--grd-text-cta`, `--clr-lossless-accent--brightest`,
 * `--ff-base` and `--fs-300`, none of which exist in this site's token set. Each
 * is mapped to the nearest semantic token here so the component responds to all
 * three modes rather than assuming a dark ground.
 *
 * PROPS:
 * - text (string, required): the label
 * - href / path (string, optional): renders an <a>; omit both for a <button>
 * - showArrow (boolean, optional): default true
 * - class (string, optional)
 */
interface Props {
  href?: string;
  path?: string;
  text: string;
  showArrow?: boolean;
  class?: string;
}

const { href, path, text, showArrow = true, class: className = '' } = Astro.props;
const Tag = href || path ? 'a' : 'button';
const tagProps = href || path ? { href: href || path } : { type: 'button' as const };
---

<Tag class:list={['text-cta', className]} {...tagProps}>
  <span class="text-cta-content">
    <span class="text-cta-text">{text}</span>
    {showArrow && (
      <span class="text-cta-arrow">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </span>
    )}
  </span>
</Tag>

<style>
  .text-cta {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--step--1);
    color: var(--clr-ink);
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .text-cta-content {
    display: flex;
    align-items: center;
    position: relative;
  }

  .text-cta-text {
    letter-spacing: 0.02em;
    position: relative;
    color: var(--clr-accent);
  }

  /* Underline grows from the left on hover — the source's signature move. */
  .text-cta-text::after {
    content: '';
    position: absolute;
    width: 0;
    height: 1px;
    bottom: -2px;
    left: 0;
    background: var(--clr-accent);
    transition: width 0.3s ease;
  }

  .text-cta-arrow {
    display: inline-flex;
    align-items: center;
    margin-left: 0.5rem;
    transform: translateX(0);
    opacity: 0.7;
    transition: transform 0.3s ease, opacity 0.3s ease;
    color: var(--clr-accent);
  }

  .text-cta:hover .text-cta-text {
    opacity: 0.9;
  }
  .text-cta:hover .text-cta-text::after {
    width: 100%;
  }
  .text-cta:hover .text-cta-arrow {
    transform: translateX(4px);
    opacity: 1;
  }

  .text-cta:focus {
    outline: none;
  }
  .text-cta:focus-visible {
    outline: 2px solid var(--clr-accent);
    outline-offset: 2px;
  }
</style>
